generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  /// Disposable database Prisma resets/replays when generating migrations.
  /// It MUST be a different database from DATABASE_URL (separate container
  /// and volume here: kltn-postgres-shadow on port 5433). Pointing this at
  /// DATABASE_URL destroys development data — see docs/database-safety.md.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum ClassStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  DROPPED
}

enum PaymentStatus {
  PENDING
  REPORTED
  CONFIRMED
  REJECTED
  REVIEW_REQUIRED
}

enum PaymentActivationIssue {
  CLASS_FULL
  CLASS_NOT_ELIGIBLE
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum PlanVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum PlanFeatureKey {
  AI_SPEAKING_ASSESSMENT
  AI_WRITING_REVIEW
  AI_TUTOR_MESSAGE
  AI_EXPLANATION
  PREMIUM_VOCAB
  PREMIUM_READING
  PREMIUM_LISTENING
  PREMIUM_SPEAKING_CONTENT
  PREMIUM_WRITING_CONTENT
  COURSE_LIBRARY_ACCESS
}

enum EntitlementUnit {
  REQUEST_COUNT
  SUBMISSIONS
  CHARACTERS
  TOKENS
  AUDIO_SECONDS
  CONTENT_ACCESS
}

enum EntitlementPeriod {
  DAY
  CALENDAR_MONTH
  BILLING_CYCLE
  LIFETIME
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum SubscriptionEventType {
  PAYMENT_ACTIVATED
  ADMIN_GRANTED
  ADMIN_EXTENDED
  ADMIN_REVOKED
}

enum PlanPurchaseStatus {
  PENDING_PAYMENT
  COMPLETED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum PlanPaymentStatus {
  PENDING
  REPORTED
  CONFIRMED
  REJECTED
  REVIEW_REQUIRED
  EXPIRED
  SUPERSEDED
}

enum PlanPaymentConfirmationSource {
  ADMIN
  AUTO_WEBHOOK
}

enum PaymentProvider {
  SEPAY
  PAYOS
}

enum MarketFulfillmentType {
  DIGITAL
  PHYSICAL
}

enum PayOSPaymentIntentType {
  PLAN
  COURSE
}

enum PayOSPaymentIntentStatus {
  PENDING
  PROCESSING
  PAID
  CANCELLED
  EXPIRED
  UNDERPAID
  FAILED
}

enum BankTransactionMatchStatus {
  RECEIVED
  MATCHED
  REVIEW_REQUIRED
  IGNORED
  DUPLICATE
}

enum AuthProvider {
  GOOGLE
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  password           String?
  role               Role      @default(STUDENT)
  emailVerifiedAt    DateTime?
  mustChangePassword Boolean   @default(false)
  refreshToken       String?
  sessionToken       String?
  loginCount         Int       @default(0)
  lastLoginAt        DateTime?
  lastDeviceType     String? // "pc" | "non-pc"
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Core Relations
  profile      Profile?
  stats        UserStats?
  billing      UserBilling?
  authAccounts AuthAccount[]

  // Other Relations
  enrollments                     Enrollment[]
  submissions                     Submission[]
  listeningPracticeAttempts       ListeningPracticeAttempt[]
  listeningTranscriptReveals      ListeningTranscriptReveal[]
  assignmentSubmissions           AssignmentSubmission[]
  pointHistory                    PointHistory[]
  userBadges                      UserBadge[]
  leaderboard                     Leaderboard?
  speakingSubmissions             SpeakingSubmission[]
  speakingUploadIntents           SpeakingUploadIntent[]
  speakingRewardLedgers           SpeakingRewardLedger[]
  bookProgresses                  UserBookProgress[]
  marketOrders                    MarketOrder[]
  gamePlays                       GamePlay[]
  watchTracking                   WatchTracking?
  aiUsages                        AiUsage[]
  listeningAudioUsages            ListeningAudioUsage[]
  vocabProgresses                 UserVocabWordProgress[]
  savedVocabulary                 UserSavedWord[]
  toeicAttempts                   ToeicAttempt[]
  toeicSpeakingWritingSubmissions ToeicSpeakingWritingSubmission[]
  toeicAssessmentsCreated         ToeicAssessment[]                @relation("ToeicAssessmentCreator")
  toeicAssessmentAttempts         ToeicAssessmentAttempt[]
  pet                             UserPet?
  questProgresses                 UserQuestProgress[]
  grammarAttempts                 GrammarAttempt[]
  pushSubscriptions               PushSubscription[]
  userGrammarRewards              UserGrammarReward[]
  userQuizRewards                 UserQuizReward[]
  reviewedPayments                Payment[]                        @relation("PaymentReviewer")
  learningActivities              LearningActivity[]
  diagnosticAttempts              DiagnosticAttempt[]
  diagnosticSpeakingResponses     DiagnosticSpeakingResponse[]
  diagnosticWritingResponses      DiagnosticWritingResponse[]
  contentAttempts                 ContentAttempt[]
  supportConversation             SupportConversation?
  supportMessages                 SupportMessage[]
  notifications                   Notification[]
  subscriptions                   Subscription[]
  subscriptionEventsActed         SubscriptionEvent[]              @relation("SubscriptionEventActor")
  planPurchases                   PlanPurchase[]
  payosPaymentIntents             PayOSPaymentIntent[]
  confirmedPlanPayments           PlanPayment[]                    @relation("PlanPaymentConfirmer")
  rejectedPlanPayments            PlanPayment[]                    @relation("PlanPaymentRejecter")
  issueReportsSubmitted           IssueReport[]                    @relation("IssueReporter")
  issueReportsAssigned            IssueReport[]                    @relation("IssueAssignee")
  suggestionsSubmitted            Suggestion[]                     @relation("SuggestionSubmitter")
  suggestionsResponded            Suggestion[]                     @relation("SuggestionResponder")
  banhTransactions                BanhTransaction[]
  dailyBanhEarnings               DailyBanhEarning[]
  vocabMasteryRewards             UserVocabMasteryReward[]
  toeicRewards                    UserToeicReward[]
  aiGenerationJobsCreated         AiGenerationJob[]                @relation("AiGenerationJobCreator")
  aiGenerationJobsReviewed        AiGenerationJob[]                @relation("AiGenerationJobReviewer")
  aiGenerationJobsPublished       AiGenerationJob[]                @relation("AiGenerationJobPublisher")
  shippingProfile                 UserShippingProfile?
  physicalRedemptions             MarketPhysicalRedemption[]
  courseLessonAttempts            CourseLessonAttempt[]
  examsCreated                    Exam[]                           @relation("ExamCreator")
}

model AuthAccount {
  id                Int          @id @default(autoincrement())
  provider          AuthProvider
  providerAccountId String
  userId            Int
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Profile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  avatar      String?
  phone       String?
  address     String?
  targetScore String? // e.g., "IELTS 7.0", "TOEIC 800"

  // Thông tin cá nhân & Phụ huynh
  parentName    String?
  parentPhone   String?
  birthYear     Int?
  nextExamDate  String? // YYYY-MM-DD
  isSelfClaimed Boolean @default(false)
}

model UserStats {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalBanhRan     Int       @default(0)
  streakCount      Int       @default(0)
  lastStreakUpdate DateTime?
  streakFreezes    Int       @default(0)
  countHeart       Int       @default(0)
  timesVocabXS     Int       @default(0)
  timesVocab       Int       @default(0)
  quizAccuracy     Float     @default(0)
  speakingAccuracy Float     @default(0)

  // Double Bánh Mì boost expiry (set when user purchases double-bread item)
  doubleBanhUntil DateTime?

  // Các trường JSON nặng
  movies                    Json?
  gameTickets               Json?
  admirationsMessage        Json?
  admirationsSentToday      Json?
  admirationsSentStoryToday Json?
  speaking                  Json? // Array of SpeakingItem
  writing                   Json? // Array of WritingItem
}

model UserBilling {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tuitionFee        Json? // Record<"YYYY-MM", { amount?, paidAt? }>
  bankQrUrl         String?
  bankName          String?
  bankBin           String?
  bankAccountNumber String?
  bankAccountName   String?
  bankAccount       String?
}

model Plan {
  id          Int        @id @default(autoincrement())
  code        String     @unique
  displayName String
  description String?
  status      PlanStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  versions PlanVersion[]
}

model PlanVersion {
  id            Int               @id @default(autoincrement())
  planId        Int
  plan          Plan              @relation(fields: [planId], references: [id], onDelete: Restrict)
  version       Int
  displayName   String?
  description   String?
  durationDays  Int?
  priceVnd      Int?
  currency      String            @default("VND")
  status        PlanVersionStatus @default(DRAFT)
  isCurrent     Boolean           @default(false)
  effectiveFrom DateTime?
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  entitlements  PlanEntitlement[]
  subscriptions Subscription[]
  purchases     PlanPurchase[]

  @@unique([planId, version])
  @@index([planId, status])
  @@index([planId, isCurrent, status])
  @@index([status, effectiveFrom])
}

model PlanEntitlement {
  id            Int                @id @default(autoincrement())
  planVersionId Int
  planVersion   PlanVersion        @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  featureKey    PlanFeatureKey
  enabled       Boolean            @default(true)
  limitValue    Int?
  unit          EntitlementUnit?
  period        EntitlementPeriod?
  scope         Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([planVersionId, featureKey])
  @@index([featureKey, enabled])
}

model Subscription {
  id             Int                @id @default(autoincrement())
  userId         Int
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  planVersionId  Int
  planVersion    PlanVersion        @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  status         SubscriptionStatus @default(ACTIVE)
  startsAt       DateTime
  endsAt         DateTime
  planPurchaseId Int?               @unique
  planPurchase   PlanPurchase?      @relation(fields: [planPurchaseId], references: [id], onDelete: Restrict)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  events SubscriptionEvent[]

  @@index([userId, status, startsAt, endsAt])
  @@index([planVersionId])
}

model SubscriptionEvent {
  id             Int                   @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  type           SubscriptionEventType
  actorUserId    Int?
  actor          User?                 @relation("SubscriptionEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  reason         String?
  previousEndsAt DateTime?
  newEndsAt      DateTime?
  idempotencyKey String?               @unique
  metadata       Json?
  createdAt      DateTime              @default(now())

  @@index([subscriptionId, createdAt])
  @@index([actorUserId])
}

model PlanPurchase {
  id                     Int                @id @default(autoincrement())
  userId                 Int
  user                   User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  planVersionId          Int
  planVersion            PlanVersion        @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  status                 PlanPurchaseStatus @default(PENDING_PAYMENT)
  amountVnd              Int
  currency               String             @default("VND")
  durationDays           Int
  idempotencyKey         String
  completedAt            DateTime?
  supersededAt           DateTime?
  supersededByPurchaseId Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  payment              PlanPayment?
  subscription         Subscription?
  supersededByPurchase PlanPurchase?  @relation("PlanPurchaseSupersession", fields: [supersededByPurchaseId], references: [id], onDelete: SetNull)
  supersededPurchases  PlanPurchase[] @relation("PlanPurchaseSupersession")

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([planVersionId])
  @@index([supersededByPurchaseId])
}

model PlanPayment {
  id                     Int                            @id @default(autoincrement())
  planPurchaseId         Int                            @unique
  planPurchase           PlanPurchase                   @relation(fields: [planPurchaseId], references: [id], onDelete: Restrict)
  amountVnd              Int
  currency               String                         @default("VND")
  transferCode           String                         @unique
  bankBin                String?
  bankName               String?
  bankAccountNumber      String?
  paymentIntentExpiresAt DateTime?
  autoMatchUntil         DateTime?
  status                 PlanPaymentStatus              @default(PENDING)
  reportedAt             DateTime?
  confirmedAt            DateTime?
  confirmedById          Int?
  confirmedBy            User?                          @relation("PlanPaymentConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmationSource     PlanPaymentConfirmationSource?
  supersededAt           DateTime?
  rejectedAt             DateTime?
  rejectedById           Int?
  rejectedBy             User?                          @relation("PlanPaymentRejecter", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectionReason        String?
  bankTransactions       BankTransaction[]
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  payosIntent            PayOSPaymentIntent?

  @@index([status, createdAt])
  @@index([confirmedById])
  @@index([rejectedById])
  @@index([status, autoMatchUntil])
}

model BankTransaction {
  id                    Int                        @id @default(autoincrement())
  provider              String
  externalTransactionId String
  bankReference         String?
  bankAccount           String?
  bankCode              String?
  gateway               String?
  transferType          String
  amount                Int
  currency              String                     @default("VND")
  paymentCode           String?
  rawContent            String?
  occurredAt            DateTime
  receivedAt            DateTime                   @default(now())
  matchStatus           BankTransactionMatchStatus @default(RECEIVED)
  matchedPlanPaymentId  Int?
  matchedPlanPayment    PlanPayment?               @relation(fields: [matchedPlanPaymentId], references: [id], onDelete: SetNull)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@unique([provider, externalTransactionId])
  @@index([matchStatus, receivedAt])
  @@index([matchedPlanPaymentId])
}

model Course {
  id             Int          @id @default(autoincrement())
  title          String
  description    String?
  thumbnail      String?
  level          String? // e.g. "BEGINNER", "INTERMEDIATE", "ADVANCED"
  curriculumType String       @default("GENERAL_ENGLISH")
  status         CourseStatus @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  classes       Class[]
  lessons       Lesson[]
  quizzes       Quiz[]
  activities    CourseActivity[]
  courseLessons CourseLesson[]
}

model Class {
  id            Int       @id @default(autoincrement())
  courseId      Int
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name          String
  startDate     DateTime?
  endDate       DateTime?
  capacity      Int?      @default(30)
  tuitionFeeVnd Int       @default(0)

  status ClassStatus @default(UPCOMING)

  enrollments   Enrollment[]
  assignments   Assignment[]
  announcements Announcement[]

  @@unique([courseId, name])
}

model Enrollment {
  id       Int              @id @default(autoincrement())
  userId   Int
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId  Int
  class    Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  joinedAt DateTime         @default(now())
  progress Float            @default(0) // Percentage 0-100
  status   EnrollmentStatus @default(ACTIVE)
  payment  Payment?

  @@unique([userId, classId])
}

model Payment {
  id                   Int                     @id @default(autoincrement())
  enrollmentId         Int                     @unique
  amountVnd            Int
  transferCode         String                  @unique
  status               PaymentStatus           @default(PENDING)
  activationIssue      PaymentActivationIssue?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  reportedAt           DateTime?
  reviewedAt           DateTime?
  confirmedAt          DateTime?
  reviewedById         Int?
  adminNote            String?
  activationNotifiedAt DateTime?

  enrollment  Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  reviewedBy  User?               @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  payosIntent PayOSPaymentIntent?

  @@index([status, createdAt])
  @@index([reviewedById])
}

model PayOSPaymentIntent {
  id                Int                      @id @default(autoincrement())
  userId            Int
  user              User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  type              PayOSPaymentIntentType
  provider          PaymentProvider          @default(PAYOS)
  orderCode         BigInt                   @unique
  paymentLinkId     String?                  @unique
  planPaymentId     Int?                     @unique
  planPayment       PlanPayment?             @relation(fields: [planPaymentId], references: [id], onDelete: Restrict)
  coursePaymentId   Int?                     @unique
  coursePayment     Payment?                 @relation(fields: [coursePaymentId], references: [id], onDelete: Restrict)
  amountVnd         Int
  currency          String                   @default("VND")
  description       String
  checkoutUrl       String?
  qrCode            String?
  bankBin           String?
  bankAccountNumber String?
  bankAccountName   String?
  status            PayOSPaymentIntentStatus @default(PENDING)
  providerStatus    String?
  expiresAt         DateTime?
  paidAt            DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([userId, status, createdAt])
  @@index([type, status, createdAt])
}

model Lesson {
  id          Int      @id @default(autoincrement())
  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int      @default(0)
  videoUrl    String?
  createdAt   DateTime @default(now())

  materials  Material[]
  activities CourseActivity[]
}

model Material {
  id          Int     @id @default(autoincrement())
  lessonId    Int
  lesson      Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title       String
  fileUrl     String
  fileType    String? // PDF, DOCX, MP3, vv.
  objective   String? @db.Text
  contentText String? @db.Text
}

/// Durable, ordered curriculum activity. Targets remain owned by their skill
/// engines; this table only describes how a course presents them.
model CourseActivity {
  id                    Int      @id @default(autoincrement())
  courseId              Int
  lessonId              Int
  order                 Int      @default(0)
  kind                  String
  title                 String?
  isRequired            Boolean  @default(true)
  quizId                Int?
  speakingPracticeSetId String?
  toeicExamId           Int?
  grammarTopicId        Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  course              Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson              Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quiz                Quiz?                @relation(fields: [quizId], references: [id], onDelete: Restrict)
  speakingPracticeSet SpeakingPracticeSet? @relation(fields: [speakingPracticeSetId], references: [id], onDelete: Restrict)
  toeicExam           ToeicExamSet?        @relation(fields: [toeicExamId], references: [id], onDelete: Restrict)
  grammarTopic        GrammarTopic?        @relation(fields: [grammarTopicId], references: [id], onDelete: Restrict)

  @@unique([lessonId, order])
  @@index([courseId, isRequired, order])
  @@index([quizId])
  @@index([speakingPracticeSetId])
  @@index([toeicExamId])
  @@index([grammarTopicId])
}

enum CourseLessonStatus {
  DRAFT
  PUBLISHED
}

enum CourseLessonSectionType {
  INTRO
  THEORY
  EXAMPLE
  TIP
  COMMON_MISTAKE
  STRATEGY
  VOCABULARY
  GRAMMAR
  READING_TEXT
  LISTENING_SCRIPT
  SPEAKING_GUIDE
  WRITING_GUIDE
  CHECKPOINT
  SUMMARY
  REFERENCE
}

enum CourseLessonExerciseType {
  MULTIPLE_CHOICE
  MULTI_SELECT
  FILL_IN_THE_BLANK
  MATCHING
  ORDERING
  TRUE_FALSE
  READING_COMPREHENSION
  LISTENING_COMPREHENSION
  VOCABULARY
  GRAMMAR
  SPEAKING_READ_ALOUD
  SPEAKING_SHORT_RESPONSE
  WRITING_SHORT_RESPONSE
  WRITING_GUIDED
  WRITING_EMAIL
  TOEIC_STYLE
  CHECKPOINT
}

enum CourseLessonAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

/// Course-owned learning graph. Legacy Lesson/CourseActivity remain readable
/// for historical compatibility, while this model is authoritative for V5.
model CourseLesson {
  id                 Int                @id @default(autoincrement())
  courseId           Int
  course             Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug               String
  title              String
  summary            String             @db.Text
  learningObjectives Json
  estimatedMinutes   Int                @default(15)
  difficulty         String?
  coverImage         String?
  order              Int                @default(0)
  status             CourseLessonStatus @default(DRAFT)
  /// Whether this lesson must have a scored Final Check exercise before it
  /// can pass validation/publish. Defaults to true to preserve existing
  /// behavior; set false for practice-only lessons that don't need one.
  requiresFinalCheck Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  sections   CourseLessonSection[]
  exercises  CourseLessonExercise[]
  references CourseLessonReference[]
  media      CourseLessonMedia[]
  attempts   CourseLessonAttempt[]

  @@unique([courseId, slug])
  @@unique([courseId, order])
  @@index([courseId, status, order])
}

model CourseLessonSection {
  id         Int                     @id @default(autoincrement())
  lessonId   Int
  lesson     CourseLesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order      Int
  type       CourseLessonSectionType
  heading    String
  content    Json
  isRequired Boolean                 @default(true)

  @@unique([lessonId, order])
  @@index([lessonId, type])
}

model CourseLessonExercise {
  id           Int                      @id @default(autoincrement())
  lessonId     Int
  lesson       CourseLesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  slug         String
  order        Int
  type         CourseLessonExerciseType
  title        String
  prompt       String                   @db.Text
  instructions String?                  @db.Text
  content      Json
  rubric       Json?
  required     Boolean                  @default(true)
  minimumScore Int?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  questions CourseLessonQuestion[]
  attempts  CourseLessonAttempt[]

  @@unique([lessonId, slug])
  @@unique([lessonId, order])
  @@index([lessonId, required, order])
}

model CourseLessonQuestion {
  id            Int                          @id @default(autoincrement())
  exerciseId    Int
  exercise      CourseLessonExercise         @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  order         Int
  prompt        String                       @db.Text
  options       Json?
  correctAnswer Json
  explanation   String                       @db.Text
  answers       CourseLessonExerciseAnswer[]

  @@unique([exerciseId, order])
}

model CourseLessonReference {
  id         Int          @id @default(autoincrement())
  lessonId   Int
  lesson     CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title      String
  publisher  String?
  url        String
  accessedAt DateTime?
  note       String?      @db.Text

  @@index([lessonId])
}

model CourseLessonMedia {
  id           Int          @id @default(autoincrement())
  lessonId     Int
  lesson       CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type         String
  url          String
  altText      String?
  provenance   String?
  renderStatus String       @default("READY")

  @@index([lessonId, type])
}

model CourseLessonAttempt {
  id          Int                       @id @default(autoincrement())
  userId      Int
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    Int
  lesson      CourseLesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exerciseId  Int
  exercise    CourseLessonExercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  status      CourseLessonAttemptStatus @default(IN_PROGRESS)
  score       Float?
  maxScore    Int?
  submittedAt DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  answers CourseLessonExerciseAnswer[]

