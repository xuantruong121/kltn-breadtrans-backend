/// Explicit lifecycle for a Diagnostic assessment. Replaces "highest id wins":
/// the learner-current form is the one with status ACTIVE, enforced by a
/// partial unique index so two forms can never both be current.
enum DiagnosticAssessmentStatus {
  DRAFT
  READY
  ACTIVE
  ARCHIVED
}

/// What kind of response an item expects. This is the authoritative
/// objective-vs-productive discriminator; scoring must never infer it from the
/// skill label (the DIAG-001 defect) or from option metadata (DIAG-008).
enum DiagnosticTaskType {
  MCQ
  OPEN_TEXT
  SPEAKING_RESPONSE
  WRITING_RESPONSE
}

/// Skills a Diagnostic item can measure. LANGUAGE_USE is auxiliary: it is
/// reported in the profile and carries weight 0 in the overall figure.
enum DiagnosticSkill {
  LISTENING
  READING
  SPEAKING
  WRITING
  LANGUAGE_USE
}

/// Grading lifecycle for a productive submission. A null score alone must never
/// be used to mean "not graded", "queued" and "failed" at the same time.
enum DiagnosticGradingStatus {
  NOT_SUBMITTED
  SUBMITTED
  QUEUED
  GRADING
  GRADED
  GRADING_FAILED
}

/// Completion state, used both for an attempt as a whole and per skill. An
/// overall figure may only be computed once every required skill is COMPLETE.
enum DiagnosticCompletionState {
  NOT_STARTED
  IN_PROGRESS
  PENDING_GRADING
  COMPLETE
  GRADING_FAILED
}

model DiagnosticAssessment {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  /// Deprecated in favour of `status`, kept so V1 code paths keep working
  /// during the transition. `status` is authoritative for learner-current.
  isActive    Boolean @default(true)

  /// Which scoring algorithm this form is scored by. Persisted so the scorer is
  /// never inferred from id, title, question count or item metadata.
  scoringVersion   String                     @default("OBJECTIVE_POOLED_V1")
  /// Which content blueprint this form implements. Separate from
  /// scoringVersion because one scorer may later serve several forms.
  blueprintVersion String?
  /// Bumped when the authored content or media of this form is revised without
  /// changing its scoring semantics.
  contentVersion   Int                        @default(1)
  status           DiagnosticAssessmentStatus @default(ACTIVE)

  questions         DiagnosticQuestion[]
  attempts          DiagnosticAttempt[]
  speakingResponses DiagnosticSpeakingResponse[]
  writingResponses  DiagnosticWritingResponse[]
  readingPassages   DiagnosticReadingPassage[]
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  /// Stable authored identity for the canonical importer. NULL on every
  /// legacy row; Postgres treats each NULL as distinct, so no collision.
  sourceKey String? @unique

  @@index([status])
}

model DiagnosticQuestion {
  id           Int                  @id @default(autoincrement())
  assessmentId Int
  assessment   DiagnosticAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  /// Legacy free-text skill label used by V1 ("Listening", "Grammar", ...).
  /// V2 authors `skillCode`; both are kept so V1 rows stay untouched.
  skill        String
  question     String               @db.Text
  options      Json
  /// -1 for productive tasks, which have no key. `taskType` is the
  /// discriminator; correctIndex must not be used to infer item kind.
  correctIndex Int
  explanation  String?              @db.Text
  order        Int                  @default(0)

  /// V2 authored structure. All optional so existing V1 rows are valid.
  taskType      DiagnosticTaskType @default(MCQ)
  skillCode     DiagnosticSkill?
  /// Constrained free string rather than an enum: the authored subskill set
  /// will grow with content and a rigid enum would force a migration per term.
  subskill      String?
  /// Content metadata only. Must never select a scoring algorithm (DIAG-008).
  intendedLevel String?
  difficulty    String?
  instructions  String?            @db.Text

  /// Productive task delivery parameters.
  prepSeconds     Int?
  responseSeconds Int?
  wordMin         Int?
  wordMax         Int?

  passageId Int?
  passage   DiagnosticReadingPassage? @relation(fields: [passageId], references: [id], onDelete: SetNull)
  rubricId  Int?
  rubric    DiagnosticRubric?         @relation(fields: [rubricId], references: [id], onDelete: SetNull)

  speakingResponses DiagnosticSpeakingResponse[]
  writingResponses  DiagnosticWritingResponse[]
  listeningClips    DiagnosticListeningClip[]

  /// Stable authored identity, unique within its assessment.
  sourceKey String?

  @@unique([assessmentId, sourceKey])
  @@index([assessmentId, order])
  @@index([assessmentId, skillCode])
  @@index([passageId])
}

model DiagnosticAttempt {
  id              Int                  @id @default(autoincrement())
  userId          Int
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentId    Int
  assessment      DiagnosticAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers         Json
  correctCount    Int
  totalCount      Int
  percentage      Float
  level           String
  submittedAt     DateTime             @default(now())
  status          String               @default("IN_PROGRESS")
  completedAt     DateTime?
  submissionToken String?

  /// Version pinning. An attempt keeps the versions it was taken under, so a
  /// later form or scorer can never reinterpret a historical result.
  scoringVersion   String?
  blueprintVersion String?
  contentVersion   Int?
  /// V2 finalization state. `overallScore` stays null - never 0 - while any
  /// required skill is incomplete.
  resultState      DiagnosticCompletionState @default(IN_PROGRESS)
  overallScore     Float?

  speakingResponses DiagnosticSpeakingResponse[]
  writingResponses  DiagnosticWritingResponse[]
  skillResults      DiagnosticSkillResult[]

  @@index([userId, submittedAt])
  @@index([userId, assessmentId, status])
}

model DiagnosticSpeakingResponse {
  id              Int                  @id @default(autoincrement())
  userId          Int
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentId    Int
  assessment      DiagnosticAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  attemptId       Int
  attempt         DiagnosticAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId      Int
  question        DiagnosticQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  taskKey         String
  status          String               @default("NOT_STARTED")
  audioKey        String?
  audioMimeType   String?
  byteSize        Int?
  durationMs      Int?
  transcript      String?              @db.Text
  score           Float?
  scoreMetadata   Json?
  provider        String?
  graderVersion   String?
  gradingAttempts Int                  @default(0)
  failureReason   String?              @db.Text
  createdAt       DateTime             @default(now())
  confirmedAt     DateTime?
  gradedAt        DateTime?

  /// Which rubric graded this response, so a historical score stays
  /// interpretable after the rubric changes.
  rubricId        Int?
  rubric          DiagnosticRubric? @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  rubricVersion   String?
  providerVersion String?

  @@unique([attemptId, questionId])
  @@index([userId, assessmentId, status])
  @@index([attemptId, status])
}

/// A Reading passage shared by several Diagnostic items, so passage text is
/// stored once rather than duplicated into every question.
model DiagnosticReadingPassage {
  id           Int                  @id @default(autoincrement())
  assessmentId Int
  assessment   DiagnosticAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  title        String?
  text         String               @db.Text
  order        Int                  @default(0)
  createdAt    DateTime             @default(now())

  questions DiagnosticQuestion[]

  /// Stable authored identity, unique within its assessment.
  sourceKey String?

  @@unique([assessmentId, sourceKey])
  @@index([assessmentId, order])
}

/// Canonical audio for a Diagnostic Listening item.
///
/// Each media-bearing subsystem in this schema owns its own asset table
/// (QuizAudioAsset, CourseLessonMedia, ListeningAudioArtifact); there is no
/// generic media model to reuse, and the similarly named
/// ListeningDiagnosticClip belongs to the quiz `Question` model, not here.
///
/// `script` is the authoritative transcript and is deliberately stored on the
/// asset rather than in the learner-facing question payload, so a service
/// projection can withhold it until the item has been answered.
model DiagnosticListeningClip {
  id         Int                @id @default(autoincrement())
  questionId Int
  question   DiagnosticQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  version    Int                @default(1)
  isActive   Boolean            @default(false)

  storageKey String
  url        String
  mimeType   String
  durationMs Int?
  byteSize   Int?

  /// Binds the audio to the words it was generated from: both hashes are
  /// recorded so the audio-to-script relationship is provable rather than
  /// inferred from a filename.
  script       String  @db.Text
  scriptSha256 String
  audioSha256  String?

  voice            String?
  locale           String?
  accent           String?
  generationSource String?

  createdAt DateTime @default(now())

  @@unique([questionId, version])
  @@index([questionId, isActive])
}

/// Versioned rubric for a productive task. Stored as a snapshot so the
/// question "which rubric graded this historical response?" stays answerable
/// after the rubric is revised.
model DiagnosticRubric {
  id            Int             @id @default(autoincrement())
  skill         DiagnosticSkill
  rubricVersion String
  /// Dimension definitions and their ranges, snapshotted at publication.
  criteria      Json
  maxScore      Float           @default(100)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())

  questions         DiagnosticQuestion[]
  speakingResponses DiagnosticSpeakingResponse[]
  writingResponses  DiagnosticWritingResponse[]

  @@unique([skill, rubricVersion])
}

/// A learner's written response to a productive Writing task.
///
/// V1 kept writing feedback inside `DiagnosticAttempt.answers.__writingFeedback`.
/// V2 stores it relationally so grading state, rubric identity and provider
/// identity are queryable and historically pinned.
model DiagnosticWritingResponse {
  id           Int                  @id @default(autoincrement())
  userId       Int
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentId Int
  assessment   DiagnosticAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  attemptId    Int
  attempt      DiagnosticAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId   Int
  question     DiagnosticQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  taskKey      String

  status       DiagnosticGradingStatus @default(NOT_SUBMITTED)
  responseText String?                 @db.Text
  wordCount    Int?

  score         Float?
  /// Validated, structured dimension scores. Never the raw provider payload.
  scoreMetadata Json?

  rubricId      Int?
  rubric        DiagnosticRubric? @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  rubricVersion String?

  provider           String?
  providerVersion    String?
  graderVersion      String?
  gradingAttempts    Int     @default(0)
  failureReason      String? @db.Text
  /// Optional audit copy of the provider response. Secondary to scoreMetadata
  /// and never the only structured state.
  rawProviderPayload Json?

  createdAt   DateTime  @default(now())
  submittedAt DateTime?
  gradedAt    DateTime?

  @@unique([attemptId, questionId])
  @@index([userId, assessmentId, status])
  @@index([attemptId, status])
}

/// Per-skill result for an attempt. V2's primary output is the skill profile,
/// so each skill carries its own score, band and completion state rather than
/// being derived from an opaque JSON blob.
model DiagnosticSkillResult {
  id          Int                       @id @default(autoincrement())
  attemptId   Int
  attempt     DiagnosticAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  skill       DiagnosticSkill
  status      DiagnosticCompletionState @default(NOT_STARTED)
  /// Null while the skill is not COMPLETE. Never 0 to mean "unknown".
  score       Float?
  /// Internal band key only (Starter/Foundation/Intermediate/Upper). No CEFR
  /// code is stored or derived here.
  band        String?
  itemsScored Int?
  itemsTotal  Int?
  updatedAt   DateTime                  @updatedAt

  @@unique([attemptId, skill])
  @@index([attemptId, status])
}

model ContentAttempt {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentTopicId Int
  contentTopic   ContentTopic @relation(fields: [contentTopicId], references: [id], onDelete: Cascade)
  answers        Json
  correctCount   Int
  totalCount     Int
  score          Float
  submittedAt    DateTime     @default(now())

  @@index([userId, contentTopicId, submittedAt])
}

model MarketProduct {
  id              Int                   @id @default(autoincrement())
  slug            String                @unique
  name            String
  description     String?               @db.Text
  category        String                @default("GENERAL")
  rarity          String                @default("COMMON")
  price           Int // Integer Bánh Mì units only
  imageUrl        String?
  order           Int                   @default(0)
  stock           Int                   @default(100)
  purchaseCount   Int                   @default(0)
  isActive        Boolean               @default(true)
  fulfillmentType MarketFulfillmentType @default(DIGITAL)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model MarketOrder {
  id                  Int                        @id @default(autoincrement())
  userId              Int
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentName         String
  items               Json // Array of item objects
  totalK              Float
  totalBanh           Int // Integer Bánh Mì units
  status              String                     @default("pending") // "pending" | "approved" | "rejected" | "completed" | "refunded" (refunded = approved/completed order whose fulfillment later failed; see MarketService.markFulfillmentFailed)
  bankSnapshot        Json?
  createdAt           DateTime                   @default(now())
  paidAtCheckout      Boolean?
  balanceAtCheckout   Int? // Integer Bánh Mì units at checkout time
  reviewedAt          DateTime?
  reviewedBy          String?
  currencyTxId        Int?
  /// Client-generated idempotency key for a single checkout request.
  idempotencyKey      String?                    @unique
  physicalRedemptions MarketPhysicalRedemption[]
}

model UserShippingProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  countryCode   String   @default("VN")
  provinceCode  String
  provinceName  String
  wardCode      String
  wardName      String
  addressLine   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model MarketPhysicalRedemption {
  id               Int         @id @default(autoincrement())
  userId           Int
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId          Int
  order            MarketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        Int
  productName      String
  quantity         Int         @default(1)
  status           String      @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  recipientName    String
  phone            String
  countryCode      String      @default("VN")
  provinceCode     String
  provinceName     String
  wardCode         String
  wardName         String
  addressLine      String
  formattedAddress String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([status])
}

model GameSettings {
  id        Int      @id @default(autoincrement())
  gameId    String   @unique // "flappy-bird", "shell-game", "caro", "sky-high"
  config    Json
  updatedAt DateTime @default(now()) @updatedAt
}

model GamePlay {
  id         Int       @id @default(autoincrement())
  playToken  String    @unique
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId     String
  difficulty String?
  status     String    @default("active") // "active" | "finished" | "expired"
  reward     Float?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  result     Json?
}

model GameBattle {
  id                Int       @id @default(autoincrement())
  roomId            String    @unique
  gameId            String
  p1Id              Int
  p2Id              Int
  stake             Float     @default(0)
  status            String    @default("pending") // "pending" | "escrowed" | "settled" | "cancelled"
  winnerRole        String? // "p1" | "p2" | "draw"
  winnerUserId      Int?
  settledWinnerRole String?
  settledAt         DateTime?
  createdAt         DateTime  @default(now())
  escrowedAt        DateTime?
}

model WatchTracking {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Json // Map keyed by video URL
  updatedAt DateTime @default(now()) @updatedAt
}

model AiUsage {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekKey   String // e.g. "2026-W24"
  count     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, weekKey])
}

enum AiGenerationJobType {
  SMART_CONTENT
  DICTATION
  TOEIC_QUIZ
  ETS_IMPORT
}

enum AiGenerationJobStatus {
  QUEUED
  PROCESSING
  GENERATED
  FAILED
  APPROVED
  PUBLISHING
  PUBLISHED
  CANCELLED
}

/// Durable Admin AI authoring lifecycle. Redis may mirror progress, but this
/// record remains the source of truth after Redis loss or backend restart.
model AiGenerationJob {
  id                 String                @id
  createdByAdminId   Int
  createdByAdmin     User                  @relation("AiGenerationJobCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  reviewedByAdminId  Int?
  reviewedByAdmin    User?                 @relation("AiGenerationJobReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  publishedByAdminId Int?
  publishedByAdmin   User?                 @relation("AiGenerationJobPublisher", fields: [publishedByAdminId], references: [id], onDelete: SetNull)
  generationType     AiGenerationJobType
  status             AiGenerationJobStatus @default(QUEUED)
  idempotencyKey     String?               @unique
  requestSnapshot    Json
  resultSnapshot     Json?
  draftSnapshot      Json?
  approvedSnapshot   Json?
  provider           String?
  model              String?
  generatorVersion   String?
  promptVersion      String?
  providerUsage      Json?
  errorSummary       String?
  failureHistory     Json?
  attempt            Int                   @default(0)
  publishedResources Json?
  createdAt          DateTime              @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  reviewedAt         DateTime?
  publishedAt        DateTime?
  updatedAt          DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([generationType, createdAt])
  @@index([createdByAdminId, createdAt])
}

/// Immutable provider-usage evidence for admin-authored listening audio.
model ListeningAudioUsage {
  id             Int                     @id @default(autoincrement())
  quizId         Int
  quiz           Quiz                    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  artifactId     Int?
  artifact       ListeningAudioArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  actorId        Int?
  actor          User?                   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  provider       String
  operation      String
  synthesisHash  String
  characterCount Int
  success        Boolean
  durationMs     Int?
  error          String?
  createdAt      DateTime                @default(now())

  @@index([quizId, createdAt])
  @@index([synthesisHash])
}

// Vocab Module Models
model VocabTopic {
  id                Int                   @id @default(autoincrement())
  title             String
  categoryName      String                @default("600 TỪ VỰNG TOEIC")
  totalWords        Int                   @default(12)
  isPro             Boolean               @default(false)
  iconUrl           String?
  publicationStatus QuizPublicationStatus @default(DRAFT)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  words VocabWord[]
}

model VocabWord {
  id           Int        @id @default(autoincrement())
  topicId      Int
  topic        VocabTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  word         String
  pos          String     @default("noun") // "verb", "noun", "adjective", "adverb"
  ipaUs        String?
  ipaUk        String?
  meaning      String
  audioUs      String?
  audioUk      String?
  exampleEn    String?    @db.Text
  exampleVi    String?    @db.Text
  collocations Json?
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  userProgress   UserVocabWordProgress[]
  masteryRewards UserVocabMasteryReward[]
}

model UserVocabWordProgress {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId         Int
  word           VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)
  isStarred      Boolean   @default(false)
  isMastered     Boolean   @default(false)
  reviewCount    Int       @default(0)
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  remindedAt     DateTime?

  @@unique([userId, wordId])
}

/// Personal dictionary snapshots. This is intentionally separate from
/// UserVocabWordProgress: saving a word must not mark it as learned or award XP.
model UserSavedWord {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  normalizedWord String
  displayWord    String
  canonicalWord  String
  partOfSpeech   String?
  meaningVi      String?
  definitionEn   String?
  ipaUs          String?
  ipaUk          String?
  exampleEn      String?
  exampleVi      String?
  collocations   Json?
  synonyms       Json?
  antonyms       Json?
  audioUs        String?
  audioUk        String?
  source         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, canonicalWord, partOfSpeech])
  @@index([userId, createdAt])
}

// ==========================================
// TOEIC PRACTICE MODULE
// ==========================================

enum ExamType {
  FULL_TEST
  PRACTICE_BY_PART
}

enum AttemptMode {
  PRACTICE
  FULL_TEST
}

model ToeicExamSet {
  id                Int                   @id @default(autoincrement())
  title             String
  description       String?               @db.Text
  type              ExamType              @default(FULL_TEST)
  difficulty        String                @default("medium") // "easy" | "medium" | "hard"
  durationSeconds   Int                   @default(7200)
  createdBy         Int?
  publicationStatus QuizPublicationStatus @default(DRAFT)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @default(now()) @updatedAt
  examId            Int?                  @unique

  genericExam          Exam?                      @relation(fields: [examId], references: [id], onDelete: SetNull)
  groups               ToeicQuestionGroup[]
  attempts             ToeicAttempt[]
  assessmentComponents ToeicAssessmentComponent[] @relation("ToeicAssessmentLrSource")
  toeicRewards         UserToeicReward[]
  courseActivities     CourseActivity[]
}

model ToeicQuestionGroup {
  id              Int          @id @default(autoincrement())
  examId          Int
  exam            ToeicExamSet @relation(fields: [examId], references: [id], onDelete: Cascade)
  part            Int // 1 to 7
  canonicalAccent String       @default("US")
  audioUrl        String?
  imageUrl        String?
  passageText     String?      @db.Text
  /// Listening transcript is the source of truth for generated audio. It is
  /// intentionally separate from reading passageText.
  transcriptText  String?      @db.Text
  /// Brief used for generated Part 1 imagery; never a learner-facing answer.
  imageBrief      String?      @db.Text
  /// Minimal per-media provenance / hashes, e.g. AI_GENERATED and the
  /// transcript hash used for TTS. Keeps legacy manually-authored rows valid.
  mediaMetadata   Json?
  groupOrder      Int          @default(0)

  questions ToeicQuestion[]
}

model ToeicQuestion {
  id             Int                @id @default(autoincrement())
  groupId        Int
  group          ToeicQuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  questionNumber Int
  text           String?            @db.Text
  options        Json // Array of 4 strings
  correctIndex   Int // 0, 1, 2, 3
  explanation    String?            @db.Text

  attemptAnswers             ToeicAttemptAnswer[]
  speakingWritingSubmissions ToeicSpeakingWritingSubmission[]
}

model ToeicAttempt {
  id                Int           @id @default(autoincrement())
  userId            Int
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId            Int
  exam              ToeicExamSet  @relation(fields: [examId], references: [id], onDelete: Cascade)
  mode              AttemptMode   @default(PRACTICE)
  status            AttemptStatus @default(PENDING_START)
  createdAt         DateTime      @default(now())
  startedAt         DateTime?
  deadline          DateTime?
  durationSeconds   Int
  submittedAt       DateTime?
  currentQuestionId Int?
  markedQuestionIds Json          @default("[]")
  timeRemaining     Int? // In seconds
  listeningScore    Int?
  readingScore      Int?
  totalScore        Int?
  listeningCorrect  Int?
  readingCorrect    Int?
  totalCorrect      Int?

  /// Strict Full Test section state only. Always null for PRACTICE attempts
  /// and for FULL_TEST attempts that predate this field (legacy-compatible —
  /// the server treats a null section the same as unrestricted/legacy).
  section           ToeicAttemptSection?
  /// Server-authoritative one-pass cursor into the deterministic Listening
  /// manifest (ordered Part 1-4 groups for this exam). Monotonically
  /// increasing; never decremented by any client action.
  listeningPosition Int                  @default(0)
  readingStartedAt  DateTime?
  readingDeadline   DateTime?

  answers             ToeicAttemptAnswer[]
  integrityEvents     ToeicIntegrityEvent[]
  assessmentComponent ToeicAssessmentAttemptComponent? @relation("ToeicAssessmentChildAttempt")
}

enum AttemptStatus {
  PENDING_START
  IN_PROGRESS
  SUBMITTED
}

enum ToeicAttemptSection {
  LISTENING
  READING
}

enum IntegrityEventType {
  FULLSCREEN_EXIT
  TAB_HIDDEN
  WINDOW_BLUR
  COPY_ATTEMPT
  PASTE_ATTEMPT
  CONTEXT_MENU_ATTEMPT
}

model ToeicIntegrityEvent {
  id         Int                @id @default(autoincrement())
  attemptId  Int
  attempt    ToeicAttempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  eventType  IntegrityEventType
  questionId Int?
  part       Int?
  createdAt  DateTime           @default(now())
  metadata   Json?

  @@index([attemptId, createdAt])
}

model ToeicAttemptAnswer {
  id            Int           @id @default(autoincrement())
  attemptId     Int
  attempt       ToeicAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    Int
  question      ToeicQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIndex Int?

  @@unique([attemptId, questionId])
}

model ToeicSpeakingWritingSubmission {
  id            Int           @id @default(autoincrement())
  userId        Int
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId    Int
  question      ToeicQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  audioUrl      String?
  textContent   String?       @db.Text
  aiGradedScore Float?
  aiTranscript  String?       @db.Text
  aiFeedback    Json? // Detailed feedback object
  gradedAt      DateTime?
}

/// A complete TOEIC Writing component composed from authoritative Writing tasks.
/// The set owns ordering and slot semantics; task content remains in Quiz.
model ToeicWritingSet {
  id                Int                   @id @default(autoincrement())
  title             String
  description       String?               @db.Text
  publicationStatus QuizPublicationStatus @default(DRAFT)
  version           Int                   @default(1)
  createdBy         Int?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  items                ToeicWritingSetItem[]
  assessmentComponents ToeicAssessmentComponent[] @relation("ToeicAssessmentWritingSource")
}

model ToeicWritingSetItem {
  id            Int             @id @default(autoincrement())
  writingSetId  Int
  writingSet    ToeicWritingSet @relation(fields: [writingSetId], references: [id], onDelete: Cascade)
  order         Int
  taskKind      String
  writingQuizId Int
  writingQuiz   Quiz            @relation(fields: [writingQuizId], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([writingSetId, order])
  @@unique([writingSetId, writingQuizId])
  @@index([writingQuizId])
}

enum ToeicAssessmentProductFamily {
  TOEIC_LR
  TOEIC_SW
  TOEIC_4_SKILLS
}

enum ToeicAssessmentComponentKind {
  LISTENING_READING
  SPEAKING
  WRITING
}

enum ToeicAssessmentAttemptStatus {
  IN_PROGRESS
  COMPLETED
}

enum ToeicAssessmentAttemptComponentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/// Parent composition only. Child content remains owned by its skill runtime.
model ToeicAssessment {
  id                Int                          @id @default(autoincrement())
  title             String
  description       String?                      @db.Text
  productFamily     ToeicAssessmentProductFamily
  publicationStatus QuizPublicationStatus        @default(DRAFT)
  version           Int                          @default(1)
  createdBy         Int?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  examId            Int?                         @unique

  creator     User?                      @relation("ToeicAssessmentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  genericExam Exam?                      @relation(fields: [examId], references: [id], onDelete: SetNull)
  components  ToeicAssessmentComponent[]
  attempts    ToeicAssessmentAttempt[]

  @@index([publicationStatus, productFamily])
}

model ToeicAssessmentComponent {
  id                    Int                          @id @default(autoincrement())
  assessmentId          Int
  kind                  ToeicAssessmentComponentKind
  order                 Int
  required              Boolean                      @default(true)
  lrExamSetId           Int?
  speakingPracticeSetId String?
  writingSetId          Int?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  assessment          ToeicAssessment                   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  lrExamSet           ToeicExamSet?                     @relation("ToeicAssessmentLrSource", fields: [lrExamSetId], references: [id], onDelete: Restrict)
  speakingPracticeSet SpeakingPracticeSet?              @relation("ToeicAssessmentSpeakingSource", fields: [speakingPracticeSetId], references: [id], onDelete: Restrict)
  writingSet          ToeicWritingSet?                  @relation("ToeicAssessmentWritingSource", fields: [writingSetId], references: [id], onDelete: Restrict)
  attemptComponents   ToeicAssessmentAttemptComponent[]

  @@unique([assessmentId, order])
  @@unique([assessmentId, kind])
  @@index([lrExamSetId])
  @@index([speakingPracticeSetId])
  @@index([writingSetId])
}

model ToeicAssessmentAttempt {
  id             Int                          @id @default(autoincrement())
  assessmentId   Int
  userId         Int
  status         ToeicAssessmentAttemptStatus @default(IN_PROGRESS)
  startedAt      DateTime                     @default(now())
  submittedAt    DateTime?
  completedAt    DateTime?
  idempotencyKey String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  assessment ToeicAssessment                   @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  user       User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  components ToeicAssessmentAttemptComponent[]

  @@unique([userId, assessmentId, idempotencyKey])
  @@index([userId, assessmentId, status])
}

model ToeicAssessmentAttemptComponent {
  id                    Int                                   @id @default(autoincrement())
  assessmentAttemptId   Int
  assessmentComponentId Int
  status                ToeicAssessmentAttemptComponentStatus @default(NOT_STARTED)
  startedAt             DateTime?
  submittedAt           DateTime?
  completedAt           DateTime?
  toeicAttemptId        Int?
  createdAt             DateTime                              @default(now())
  updatedAt             DateTime                              @updatedAt

  assessmentAttempt   ToeicAssessmentAttempt              @relation(fields: [assessmentAttemptId], references: [id], onDelete: Cascade)
  assessmentComponent ToeicAssessmentComponent            @relation(fields: [assessmentComponentId], references: [id], onDelete: Restrict)
  toeicAttempt        ToeicAttempt?                       @relation("ToeicAssessmentChildAttempt", fields: [toeicAttemptId], references: [id], onDelete: SetNull)
  speakingSubmissions ToeicAssessmentSpeakingSubmission[]
  writingSubmissions  ToeicAssessmentWritingSubmission[]

  @@unique([assessmentAttemptId, assessmentComponentId])
  @@unique([toeicAttemptId])
  @@index([assessmentAttemptId, status])
}

model ToeicAssessmentSpeakingSubmission {
  id                   Int      @id @default(autoincrement())
  attemptComponentId   Int
  speakingSubmissionId Int
  createdAt            DateTime @default(now())

  attemptComponent   ToeicAssessmentAttemptComponent @relation(fields: [attemptComponentId], references: [id], onDelete: Cascade)
  speakingSubmission SpeakingSubmission              @relation(fields: [speakingSubmissionId], references: [id], onDelete: Restrict)

  @@unique([attemptComponentId, speakingSubmissionId])
  @@unique([speakingSubmissionId])
}

model ToeicAssessmentWritingSubmission {
  id                 Int      @id @default(autoincrement())
  attemptComponentId Int
  submissionId       Int
  createdAt          DateTime @default(now())

  attemptComponent ToeicAssessmentAttemptComponent @relation(fields: [attemptComponentId], references: [id], onDelete: Cascade)
  submission       Submission                      @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@unique([attemptComponentId, submissionId])
  @@unique([submissionId])
}

// ==========================================
// PET & DAILY QUESTS (GAMIFICATION)
// ==========================================

model UserPet {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String    @default("Bread")
  health    Int       @default(100) // 0-100
  happiness Int       @default(100) // 0-100
  level     Int       @default(1)
  exp       Int       @default(0)
  roster    Json? // Per-species stats plus dailyFeedDateKey, dailyFeedCount, dailyRewardedFeedCount
  lastFedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
}

model DailyQuest {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  targetValue Int     @default(1) // e.g. 50 XP
  type        String // "EARN_XP", "DO_SPEAKING", "COMPLETE_LESSON"
  rewardXP    Int     @default(10)
  rewardBanh  Int     @default(5)
  isActive    Boolean @default(true)

  userProgress UserQuestProgress[]
}

model UserQuestProgress {
  id           Int        @id @default(autoincrement())
  userId       Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId      Int
  quest        DailyQuest @relation(fields: [questId], references: [id], onDelete: Cascade)
  currentValue Int        @default(0)
  isCompleted  Boolean    @default(false)
  completedAt  DateTime?
  dateKey      String // e.g. "2026-08-13" to refresh daily

  @@unique([userId, questId, dateKey])
}

// ==========================================
// GRAMMAR MODULE
// ==========================================

model GrammarTopic {
  id                Int                   @id @default(autoincrement())
  title             String
  level             String                @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  description       String?               @db.Text
  videoYoutubeId    String?
  keyFormula        String?               @db.Text
  order             Int                   @default(0)
  publicationStatus QuizPublicationStatus @default(DRAFT)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @default(now()) @updatedAt

  questions        GrammarQuestion[]
  attempts         GrammarAttempt[]
  rewards          UserGrammarReward[]
  courseActivities CourseActivity[]
}

model GrammarQuestion {
  id           Int          @id @default(autoincrement())
  topicId      Int
  topic        GrammarTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  question     String       @db.Text
  options      Json // Array of 4 strings
  correctIndex Int
  explanation  String?      @db.Text
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
}

model GrammarAttempt {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   Int
  topic     GrammarTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  score     Float
  answers   Json // User answers mapping / array
  createdAt DateTime     @default(now())
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserGrammarReward {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   Int
  topic     GrammarTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, topicId])
}

model UserQuizReward {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId    Int
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, quizId])
}

enum SupportMode {
  AI
  HUMAN
}

enum SupportSenderRole {
  STUDENT
  ADMIN
  AI
  SYSTEM
}

enum IssueReportArea {
  LISTENING
  SPEAKING
  READING
  WRITING
  VOCABULARY
  GRAMMAR
  TOEIC
  COURSE
  DASHBOARD
  MARKET
  PET
  AUTH
  ADMIN
  OTHER
}

enum IssueReportCategory {
  CONTENT_ERROR
  ANSWER_ERROR
  EXPLANATION_ERROR
  AUDIO_ERROR
  IMAGE_ERROR
  SCORING_ERROR
  TECHNICAL_ERROR
  ACCESSIBILITY
  OTHER
}

enum IssueReportImpact {
  NON_BLOCKING
  BLOCKING
}

enum IssueReportStatus {
  NEW
  IN_REVIEW
  RESOLVED
  REJECTED
  DUPLICATE
}

enum SuggestionCategory {
  FEATURE
  CONTENT
  UI
  BUG
  OTHER
}

enum SuggestionStatus {
  PENDING
  REVIEWING
  RESPONDED
  RESOLVED
  REJECTED
}

enum SuggestionAttachmentType {
  IMAGE
  FILE
  LINK
}

model SupportConversation {
  id            Int         @id @default(autoincrement())
  studentId     Int         @unique
  student       User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mode          SupportMode @default(AI)
  status        String      @default("OPEN")
  lastMessageAt DateTime?   @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  messages SupportMessage[]

  @@index([lastMessageAt])
  @@index([studentId, status])
}

model SupportMessage {
  id              Int                 @id @default(autoincrement())
  conversationId  Int
  conversation    SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId    Int?
  senderUser      User?               @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  senderRole      SupportSenderRole   @default(STUDENT)
  senderName      String?
  content         String              @db.Text
  clientMessageId String?
  isRead          Boolean             @default(false)
  createdAt       DateTime            @default(now())

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderUserId])
}

// ==========================================
// NOTIFICATIONS INBOX MODULE
// ==========================================

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  url       String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model IssueReport {
  id              Int                 @id @default(autoincrement())
  reportCode      String              @unique
  reporterId      Int
  reporter        User                @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assignedAdminId Int?
  assignedAdmin   User?               @relation("IssueAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  area            IssueReportArea
  category        IssueReportCategory
  impact          IssueReportImpact   @default(NON_BLOCKING)
  status          IssueReportStatus   @default(NEW)
  description     String              @db.Text
  route           String?
  sourceType      String?
  sourceId        String?
  questionId      Int?
  context         Json?
  resolutionNote  String?             @db.Text
  resolvedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([area, category])
  @@index([reporterId, createdAt])
}

model Suggestion {
  id            Int                    @id @default(autoincrement())
  userId        Int
  user          User                   @relation("SuggestionSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  category      SuggestionCategory
  content       String                 @db.Text
  status        SuggestionStatus       @default(PENDING)
  adminResponse String?                @db.Text
  respondedAt   DateTime?
  respondedById Int?
  respondedBy   User?                  @relation("SuggestionResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  attachments   SuggestionAttachment[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model SuggestionAttachment {
  id           Int                      @id @default(autoincrement())
  suggestionId Int
  suggestion   Suggestion               @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  type         SuggestionAttachmentType
  name         String
  url          String                   @db.Text
  createdAt    DateTime                 @default(now())

  @@index([suggestionId])
}

// ==========================================
// ECONOMY SEPARATION — PHASE 1
// ==========================================

/// Atomic daily cap ledger for Bánh Mì earnings (per user, per Vietnam date)
model DailyBanhEarning {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey       String // "YYYY-MM-DD" in Asia/Ho_Chi_Minh
  earnedBanh    Int      @default(0) // Cumulative capped earnings for this day
  vocabCount    Int      @default(0) // Words rewarded today (max 30)
  speakingCount Int      @default(0) // Speaking submissions rewarded today (max 3)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, dateKey])
  @@index([dateKey])
}

/// Immutable Bánh Mì ledger — every credit and debit recorded here
model BanhTransaction {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int // Positive = credit, Negative = debit
  source       String // VOCAB_MASTERY | QUIZ_FIRST_COMPLETION | QUIZ_RETAKE | TOEIC_COMPLETION | TOEIC_PRACTICE | SPEAKING_SUBMISSION | GRAMMAR_COMPLETION | ASSIGNMENT_COMPLETION | DAILY_QUEST | PET_FEED | MARKET_PURCHASE | MARKET_REFUND | ADMIN_ADJUSTMENT | ARENA_WIN | ARENA_STAKE | ARENA_REFUND | GAME_REWARD | CONTENT_COMPLETION | DIAGNOSTIC_COMPLETION | SEED_FIXTURE (dev/demo seed opening balances only — never written by runtime code) | LEGACY_RECONCILIATION (one-time compensating entry that reconciles the ledger to a pre-existing UserStats.totalBanhRan without ever changing that balance — see GamificationService.appendLegacyReconciliationEntry)
  reference    String? // Unique idempotency key (e.g. "quiz:42", "vocab:word:7", "quest:1:2026-09-15")
  dateKey      String // "YYYY-MM-DD" in Asia/Ho_Chi_Minh at time of transaction
  isCapped     Boolean  @default(true) // false = exempt from daily cap (admin, refund, system)
  balanceAfter Int // Snapshot of totalBanhRan after this transaction
  metadata     Json? // Extra context (score, questTitle, etc)
  createdAt    DateTime @default(now())

  @@unique([userId, source, reference])
  @@index([userId, dateKey])
  @@index([userId, createdAt])
}

/// Lifetime-unique vocabulary first-mastery reward ledger (prevents re-mastery farming)
model UserVocabMasteryReward {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId      Int
  word        VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)
  rewardedAt  DateTime  @default(now())
  banhGranted Int       @default(0)

  @@unique([userId, wordId])
  @@index([userId])
}

/// Idempotent TOEIC completion reward ledger (per user/exam/mode)
model UserToeicReward {
  id          Int          @id @default(autoincrement())
  userId      Int
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId      Int
  exam        ToeicExamSet @relation(fields: [examId], references: [id], onDelete: Cascade)
  mode        String // "PRACTICE" | "FULL_TEST" | "PART:{n}"
  rewardedAt  DateTime     @default(now())
  banhGranted Int          @default(0)

  @@unique([userId, examId, mode])
  @@index([userId])
}
