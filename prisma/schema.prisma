generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum ClassStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  DROPPED
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  password       String
  role           Role     @default(STUDENT)
  refreshToken   String?
  sessionToken   String?
  loginCount     Int      @default(0)
  lastLoginAt    DateTime?
  lastDeviceType String? // "pc" | "non-pc"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Core Relations
  profile             Profile?
  stats               UserStats?
  billing             UserBilling?

  // Other Relations
  enrollments         Enrollment[]
  teachingClasses     Class[]               @relation("TeacherClasses")
  teachingCourses     Course[]              @relation("TeacherCourses")
  submissions         Submission[]
  assignmentSubmissions AssignmentSubmission[]
  attendances         Attendance[]
  pointHistory        PointHistory[]
  userBadges          UserBadge[]
  leaderboard         Leaderboard?
  speakingSubmissions SpeakingSubmission[]
  bookProgresses      UserBookProgress[]
  marketOrders        MarketOrder[]
  gamePlays           GamePlay[]
  watchTracking       WatchTracking?
  aiUsages            AiUsage[]
  vocabProgresses     UserVocabWordProgress[]
  toeicAttempts       ToeicAttempt[]
  toeicSpeakingWritingSubmissions ToeicSpeakingWritingSubmission[]
  pet                 UserPet?
  questProgresses     UserQuestProgress[]
  grammarAttempts     GrammarAttempt[]
  pushSubscriptions   PushSubscription[]
}

model Profile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  avatar      String?
  phone       String?
  address     String?
  targetScore String? // e.g., "IELTS 7.0", "TOEIC 800"
  
  // Thông tin cá nhân & Phụ huynh
  parentName      String?
  parentPhone     String?
  birthYear       Int?
  nextExamDate    String? // YYYY-MM-DD
  isSelfClaimed   Boolean @default(false)
}

model UserStats {
  id                        Int       @id @default(autoincrement())
  userId                    Int       @unique
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  totalBanhRan              Int       @default(0)
  streakCount               Int       @default(0)
  lastStreakUpdate          DateTime?
  streakFreezes             Int       @default(0)
  countHeart                Int       @default(0)
  timesVocabXS              Int       @default(0)
  timesVocab                Int       @default(0)
  quizAccuracy              Float     @default(0)
  speakingAccuracy          Float     @default(0)
  
  // Các trường JSON nặng
  movies                    Json?
  gameTickets               Json?
  admirationsMessage        Json?
  admirationsSentToday      Json?
  admirationsSentStoryToday Json?
  speaking                  Json? // Array of SpeakingItem
  writing                   Json? // Array of WritingItem
}

model UserBilling {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tuitionFee        Json?     // Record<"YYYY-MM", { amount?, paidAt? }>
  bankQrUrl         String?
  bankName          String?
  bankBin           String?
  bankAccountNumber String?
  bankAccountName   String?
  bankAccount       String?
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  thumbnail   String?
  level       String?  // e.g. "BEGINNER", "INTERMEDIATE", "ADVANCED"
  teacherId   Int?
  teacher     User?    @relation("TeacherCourses", fields: [teacherId], references: [id])
  status      CourseStatus @default(PUBLISHED)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classes Class[]
  lessons Lesson[]
  quizzes Quiz[]
}

model Class {
  id          Int       @id @default(autoincrement())
  courseId    Int
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId   Int
  teacher     User      @relation("TeacherClasses", fields: [teacherId], references: [id])
  name        String
  startDate   DateTime?
  endDate     DateTime?
  meetingLink String? // Google Meet/Zoom link

  // Bổ sung các trường từ Firestore Classes Schema
  status             ClassStatus @default(UPCOMING)
  links              Json? // { zalo?, meet? }
  summary            Json?
  noteProcess        String?
  rank               Json? // ClassRankSnapshot
  stories            Json? // Record<userId, Record<storyId, IClassStory>>
  pendingEvaluations Json? // Record<"studentId_bookId_lessonId", ...>

  enrollments   Enrollment[]
  sessions      Session[]
  assignments   Assignment[]
  announcements Announcement[]
}

model Enrollment {
  id       Int      @id @default(autoincrement())
  userId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId  Int
  class    Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())
  progress Float    @default(0) // Percentage 0-100
  status   EnrollmentStatus @default(ACTIVE)

  @@unique([userId, classId])
}

model Lesson {
  id          Int      @id @default(autoincrement())
  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int      @default(0)
  videoUrl    String?
  createdAt   DateTime @default(now())

  materials Material[]
}

model Material {
  id       Int     @id @default(autoincrement())
  lessonId Int
  lesson   Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title    String
  fileUrl  String
  fileType String? // PDF, DOCX, MP3, vv.
}

model Session {
  id          Int      @id @default(autoincrement())
  classId     Int
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  title       String
  startTime   DateTime
  endTime     DateTime
  meetingLink String?
  status      String   @default("scheduled")
  lessonNote  String?  @db.Text
  recordingUrl String?
  createdAt   DateTime @default(now())

  attendances Attendance[]
}

model Attendance {
  id        Int      @id @default(autoincrement())
  sessionId Int
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPresent Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([sessionId, userId])
}

enum AssignmentType {
  ESSAY
  QUIZ
}

model Assignment {
  id          Int      @id @default(autoincrement())
  classId     Int
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  dueDate     DateTime?
  type        AssignmentType @default(ESSAY)
  quizData    Json?    // Array of { question, options: string[], correctOptionIndex: number }
  createdAt   DateTime @default(now())

  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String?    @db.Text
  fileUrl      String?
  quizAnswers  Json?      // Array of selected option indices corresponding to quizData questions
  grade        Float?
  feedback     String?    @db.Text
  submittedAt  DateTime   @default(now())

  @@unique([assignmentId, userId])
}

model Announcement {
  id        Int      @id @default(autoincrement())
  classId   Int
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
}


enum TopicCategory {
  GRAMMAR_TOPIC
  GRAMMAR_LEVEL
  GRAMMAR_MOCK_TEST
  BILINGUAL_LEVEL
  WRITING_PART1
  WRITING_PART2
}

model PracticeTopic {
  id             Int           @id @default(autoincrement())
  name           String
  vietnameseName String?
  category       TopicCategory
  iconUrl        String?
  order          Int           @default(0)
  createdAt      DateTime      @default(now())

  quizzes Quiz[]
}

enum QuizType {
  TOEIC
  LISTENING_PRACTICE
  BILINGUAL_READING
  WRITING_PICTURE
  WRITING_EMAIL
}

model Quiz {
  id              Int            @id @default(autoincrement())
  courseId        Int?
  course          Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  practiceTopicId Int?
  practiceTopic   PracticeTopic? @relation(fields: [practiceTopicId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  theoryContent   String?        @db.Text
  bilingualContent Json? // Array of { en: string, vi: string }
  type            QuizType       @default(TOEIC)
  timeLimit       Int? // In minutes
  createdAt       DateTime       @default(now())

  questions   Question[]
  submissions Submission[]
}

model Question {
  id      Int    @id @default(autoincrement())
  quizId  Int
  quiz    Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type    String // MULTIPLE_CHOICE, FILL_IN_BLANK, WRITING, SPEAKING
  content Json // Flexible structure for different question types (JSONB)
  order   Int    @default(0)
}

model Submission {
  id          Int      @id @default(autoincrement())
  quizId      Int
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Float?
  submittedAt DateTime @default(now())
  aiFeedback  String?  @db.Text

  results Result[]
}

model Result {
  id           Int        @id @default(autoincrement())
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   Int
  answer       Json // User's answer
  isCorrect    Boolean?
  score        Float?
}

// Gamification Models
model Leaderboard {
  id          Int  @id @default(autoincrement())
  userId      Int  @unique
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalPoints Int  @default(0)
  rank        Int?
  tier        String @default("Đồng") // Đồng, Bạc, Vàng, Bạch Kim, Kim Cương
  weeklyExp   Int    @default(0)
}

model Badge {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  iconUrl     String?
  criteria    Json // vd: { type: "POINTS", threshold: 1000 }

  userBadges UserBadge[]
}

model UserBadge {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   Int
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model PointHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int
  reason    String // vd: "Completed Quiz", "Daily Login"
  createdAt DateTime @default(now())
}

// Speaking Practice Models
model SpeakingExercise {
  id         Int      @id @default(autoincrement())
  title      String
  targetText String   @db.Text // Câu/đoạn văn cần đọc (hoặc script mẫu)
  imageUrl   String? // Dùng cho TOEIC Part 1 (Mô tả tranh)
  audioUrl   String? // Dùng cho TOEIC Part 2/3 (Nghe và phản hồi)
  difficulty String   @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  category   String   @default("TOEIC") // IELTS, TOEIC, GENERAL
  createdAt  DateTime @default(now())

  submissions SpeakingSubmission[]
}

model SpeakingSubmission {
  id           Int              @id @default(autoincrement())
  exerciseId   Int
  exercise     SpeakingExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  userId       Int
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  audioUrl     String // URL file audio lưu trên Cloudflare R2
  overallScore Float? // Điểm tổng (0-10)
  aiFeedback   Json? // JSON structured feedback từ Gemini
  submittedAt  DateTime         @default(now())
}

// ==========================================
// MODELS BỔ SUNG TỪ FIRESTORE SCHEMA DỰ ÁN BREADTRANS
// ==========================================

model UserBookProgress {
  id                       Int      @id @default(autoincrement())
  userId                   Int
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId                   String
  lessons                  Json? // Record<lessonId, LessonProgress>
  completedLessons         Json? // Array of Int
  completedLessonsSpeaking Json? // Array of Int
  needQuizs                Json?
  needSpeakings            Json?
  lastUpdated              DateTime @default(now()) @updatedAt

  @@unique([userId, bookId])
}

model CurrencyTransaction {
  id          Int      @id @default(autoincrement())
  studentId   Int
  studentName String
  userId      Int
  userName    String
  userRole    String
  amount      Float
  reason      String
  type        String // "add" | "subtract" | "shopee"
  classId     Int?
  gameMeta    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CurrencyRequest {
  id          Int       @id @default(autoincrement())
  studentId   Int
  studentName String
  teacherId   Int
  teacherName String
  classId     Int
  className   String
  amount      Float
  reason      String
  status      String    @default("pending") // "pending" | "approved" | "rejected"
  createdAt   DateTime  @default(now())
  reviewedBy  String?
  reviewedAt  DateTime?
}

model ClassAttendance {
  id        Int      @id @default(autoincrement())
  classId   Int
  month     Int
  year      Int
  days      Json // Record<"YYYY-MM-DD", Record<userId, status>>
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([classId, month, year])
}

model ContentTopic {
  id            Int      @id @default(autoincrement())
  topicId       String   @unique
  category      String // "grammar" | "movie" | "music"
  title         String
  order         Int?     @default(0)
  materialLinks Json?
  exercises     Json? // Array of ContentExercise
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MarketProduct {
  id            Int      @id @default(autoincrement())
  name          String
  price         Float
  imageUrl      String?
  order         Int      @default(0)
  purchaseCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MarketOrder {
  id                Int       @id @default(autoincrement())
  userId            Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentName       String
  items             Json // Array of item objects
  totalK            Float
  totalBanh         Float
  status            String    @default("pending") // "pending" | "approved" | "rejected"
  bankSnapshot      Json?
  createdAt         DateTime  @default(now())
  paidAtCheckout    Boolean?
  balanceAtCheckout Float?
  reviewedAt        DateTime?
  reviewedBy        String?
  currencyTxId      Int?
}

model GameSettings {
  id        Int      @id @default(autoincrement())
  gameId    String   @unique // "flappy-bird", "shell-game", "caro", "sky-high"
  config    Json
  updatedAt DateTime @default(now()) @updatedAt
}

model GamePlay {
  id         Int       @id @default(autoincrement())
  playToken  String    @unique
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId     String
  difficulty String?
  status     String    @default("active") // "active" | "finished" | "expired"
  reward     Float?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  result     Json?
}

model GameBattle {
  id                Int       @id @default(autoincrement())
  roomId            String    @unique
  gameId            String
  p1Id              Int
  p2Id              Int
  stake             Float     @default(0)
  status            String    @default("pending") // "pending" | "escrowed" | "settled" | "cancelled"
  winnerRole        String? // "p1" | "p2" | "draw"
  winnerUserId      Int?
  settledWinnerRole String?
  settledAt         DateTime?
  createdAt         DateTime  @default(now())
  escrowedAt        DateTime?
}

model WatchTracking {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Json // Map keyed by video URL
  updatedAt DateTime @default(now()) @updatedAt
}

model AiUsage {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekKey   String // e.g. "2026-W24"
  count     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, weekKey])
}

model SpeakingEvalRetry {
  id                       Int       @id @default(autoincrement())
  jobId                    String    @unique
  studentId                Int
  bookId                   String
  lessonId                 String
  audioUrl                 String
  audioMimeType            String?
  recordedDurationSeconds  Float?
  referenceDurationSeconds Float?
  script                   String?   @db.Text
  retryCount               Int       @default(0)
  maxAttempts              Int       @default(3)
  status                   String    @default("pending") // "pending" | "failed" | "resolved"
  nextRetryAt              DateTime?
  lastError                String?   @db.Text
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @default(now()) @updatedAt
  failedAt                 DateTime?
  resolvedAt               DateTime?
}

// Vocab Module Models
model VocabTopic {
  id           Int          @id @default(autoincrement())
  title        String
  categoryName String       @default("600 TỪ VỰNG TOEIC")
  totalWords   Int          @default(12)
  isPro        Boolean      @default(false)
  iconUrl      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  words        VocabWord[]
}

model VocabWord {
  id          Int      @id @default(autoincrement())
  topicId     Int
  topic       VocabTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  word        String
  pos         String   @default("noun") // "verb", "noun", "adjective", "adverb"
  ipaUs       String?
  ipaUk       String?
  meaning     String
  audioUs     String?
  audioUk     String?
  exampleEn   String?  @db.Text
  exampleVi   String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  userProgress UserVocabWordProgress[]
}

model UserVocabWordProgress {
  id             Int        @id @default(autoincrement())
  userId         Int
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId         Int
  word           VocabWord  @relation(fields: [wordId], references: [id], onDelete: Cascade)
  isStarred      Boolean    @default(false)
  isMastered     Boolean    @default(false)
  reviewCount    Int        @default(0)
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?

  @@unique([userId, wordId])
}

// ==========================================
// TOEIC PRACTICE MODULE
// ==========================================

enum ExamType {
  FULL_TEST
  PRACTICE_BY_PART
}

enum AttemptMode {
  PRACTICE
  FULL_TEST
}

model ToeicExamSet {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  type        ExamType @default(FULL_TEST)
  difficulty  String   @default("medium") // "easy" | "medium" | "hard"
  createdBy   Int?
  createdAt   DateTime @default(now())

  groups      ToeicQuestionGroup[]
  attempts    ToeicAttempt[]
}

model ToeicQuestionGroup {
  id           Int      @id @default(autoincrement())
  examId       Int
  exam         ToeicExamSet @relation(fields: [examId], references: [id], onDelete: Cascade)
  part         Int      // 1 to 7
  audioUrl     String?
  imageUrl     String?
  passageText  String?  @db.Text
  groupOrder   Int      @default(0)

  questions    ToeicQuestion[]
}

model ToeicQuestion {
  id             Int      @id @default(autoincrement())
  groupId        Int
  group          ToeicQuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  questionNumber Int
  text           String?  @db.Text
  options        Json     // Array of 4 strings
  correctIndex   Int      // 0, 1, 2, 3
  explanation    String?  @db.Text

  attemptAnswers ToeicAttemptAnswer[]
  speakingWritingSubmissions ToeicSpeakingWritingSubmission[]
}

model ToeicAttempt {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId          Int
  exam            ToeicExamSet @relation(fields: [examId], references: [id], onDelete: Cascade)
  mode            AttemptMode  @default(PRACTICE)
  startedAt       DateTime @default(now())
  submittedAt     DateTime?
  timeRemaining   Int?     // In seconds
  listeningScore  Int?
  readingScore    Int?
  totalScore      Int?

  answers         ToeicAttemptAnswer[]
}

model ToeicAttemptAnswer {
  id            Int      @id @default(autoincrement())
  attemptId     Int
  attempt       ToeicAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    Int
  question      ToeicQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIndex Int?

  @@unique([attemptId, questionId])
}

model ToeicSpeakingWritingSubmission {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId    Int
  question      ToeicQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  audioUrl      String?
  textContent   String?  @db.Text
  aiGradedScore Float?
  aiTranscript  String?  @db.Text
  aiFeedback    Json?    // Detailed feedback object
  gradedAt      DateTime?
}

// ==========================================
// PET & DAILY QUESTS (GAMIFICATION)
// ==========================================

model UserPet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("Bread")
  health    Int      @default(100) // 0-100
  happiness Int      @default(100) // 0-100
  level     Int      @default(1)
  exp       Int      @default(0)
  roster    Json?    // Per-species stats roster: { [speciesId]: { level, exp, health, happiness, lastFedAt } }
  lastFedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model DailyQuest {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  targetValue Int      @default(1) // e.g. 50 XP
  type        String   // "EARN_XP", "DO_SPEAKING", "COMPLETE_LESSON"
  rewardXP    Int      @default(10)
  rewardBanh  Int      @default(5)
  isActive    Boolean  @default(true)

  userProgress UserQuestProgress[]
}

model UserQuestProgress {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId      Int
  quest        DailyQuest @relation(fields: [questId], references: [id], onDelete: Cascade)
  currentValue Int      @default(0)
  isCompleted  Boolean  @default(false)
  completedAt  DateTime?
  dateKey      String   // e.g. "2026-08-13" to refresh daily

  @@unique([userId, questId, dateKey])
}

// ==========================================
// GRAMMAR MODULE
// ==========================================

model GrammarTopic {
  id             Int               @id @default(autoincrement())
  title          String
  level          String            @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  description    String?           @db.Text
  videoYoutubeId String?
  keyFormula     String?           @db.Text
  order          Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt

  questions      GrammarQuestion[]
  attempts       GrammarAttempt[]
}

model GrammarQuestion {
  id           Int          @id @default(autoincrement())
  topicId      Int
  topic        GrammarTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  question     String       @db.Text
  options      Json         // Array of 4 strings
  correctIndex Int
  explanation  String?      @db.Text
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
}

model GrammarAttempt {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   Int
  topic     GrammarTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  score     Float
  answers   Json         // User answers mapping / array
  createdAt DateTime     @default(now())
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}


