node_modules
dist

# Keep environment variables out of version control
.env
.env.production
.env.local
# Any local copy/backup of a real .env still holds live secrets.
.env.bak*
.env.*.bak
.env.backup*

/generated/prisma

# Build artifacts & scratch
scratch/
cloudflared.exe
*.exe

# Test environment — local only, never commit secrets
.env.test
.env.test.local

# Database backups and disaster-recovery artifacts (may contain real data;
# can be hundreds of MB). Never commit these.
*.dump
*.sql.gz
*.tgz
db-backups/
.local-backups/
recovery-inspect.sql
# Rewritten by every backup: a local receipt, not a source file.
artifacts/offsite-backup-verification.json

# Local data backups (may contain learner data) - never commit
/backups/

# TOEIC Listening master media (rebuild with scripts/toeic-listening-master.ts); keep only the JSON manifests
artifacts/toeic-listening-master/**/build/
artifacts/toeic-listening-master/**/clips/
artifacts/toeic-listening-master/**/*.wav
artifacts/toeic-listening-master/**/*.mp3
