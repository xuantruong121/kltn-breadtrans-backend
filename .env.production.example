# ============================================================
# BreadTrans — Production Environment Variables
# Copy file này thành .env.production và điền các giá trị thực
# KHÔNG commit file .env.production lên Git!
# ============================================================

# ─── PostgreSQL (dùng bởi docker-compose.production.yml) ────
POSTGRES_USER=breadtrans
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=breadtrans_db

# ─── DATABASE URL (Prisma) ───────────────────────────────────
# Kết nối nội bộ qua Docker network — không đổi host "postgres"
DATABASE_URL="postgresql://breadtrans:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/breadtrans_db?schema=public"

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# ─── JWT ────────────────────────────────────────────────────
# Tạo bằng: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_SUPER_SECRET_JWT_KEY_MIN_32_CHARS

# ─── AI (Google Gemini) ─────────────────────────────────────
# Lấy API Key từ https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY_HERE

# ─── Cloudflare R2 Storage ──────────────────────────────────
# Lấy thông tin từ Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Account ID: Cloudflare Dashboard → right sidebar
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
# Tên bucket R2 đã tạo
R2_BUCKET_NAME=breadtrans-files
# Access Key ID từ R2 API Token
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
# Secret Access Key từ R2 API Token
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
# Public URL để access file (bật Custom Domain hoặc dùng r2.dev subdomain)
# Ví dụ: https://pub-xxxx.r2.dev  HOẶC  https://files.breadtrans.xyz
R2_PUBLIC_URL=https://YOUR_R2_PUBLIC_URL_HERE

# ─── CORS ───────────────────────────────────────────────────
# Domain của Frontend (Vercel / Cloudflare Pages)
# Khi FE được deploy, đổi thành URL thật của FE
# Ví dụ: https://breadtrans.vercel.app hoặc https://app.breadtrans.edu.vn
CORS_ORIGIN=https://breadtrans.edu.vn

# ─── App ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
