{
  "name": "temp-app",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-backend.ps1",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "ci:check": "npm run lint:check && npm run typecheck && npm run build && npm test -- --ci --runInBand",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --forceExit",
    "db:safety-check": "ts-node scripts/db-safety-guard.ts",
    "db:migrate:dev:safe": "npm run db:safety-check && prisma migrate dev",
    "db:migrate:diff:safe": "npm run db:safety-check && prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"%SHADOW_DATABASE_URL%\" --script",
    "db:migrate:reset:safe": "npm run db:safety-check && prisma migrate reset",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:safe": "ts-node scripts/db-seed-safe.ts",
    "db:seed:rehearse": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-seed-rehearsal.ps1",
    "db:r2:inventory": "ts-node scripts/r2-inventory.ts",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-backup.ps1",
    "db:backup:sync-r2": "ts-node scripts/db-backup-sync-all.ts",
    "db:restore:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-restore-drill.ps1",
    "bootstrap:plans": "ts-node scripts/bootstrap-plan-catalog.ts",
    "reconstruct:ipa-course": "ts-node scripts/reconstruct-ipa-course.ts",
    "inspect:foundation-courses": "ts-node scripts/inspect-foundation-course-state.ts",
    "verify:access-tiers": "ts-node scripts/verify-access-tier-runtime.ts",
    "verify:course-v5-runtime": "ts-node scripts/verify-course-v5-runtime.ts",
    "audit:premium-content": "ts-node scripts/audit-premium-content-recovery.ts",
    "audit:learner-routes": "ts-node scripts/build-learner-route-recovery-map.ts",
    "crawl:learner-read-apis": "ts-node scripts/crawl-learner-read-apis.ts",
    "smoke:learner-browser": "ts-node scripts/smoke-learner-browser.ts",
    "rollout:premium-content": "ts-node scripts/rollout-premium-content.ts",
    "materialize:listening-audio": "ts-node scripts/materialize-listening-audio.ts",
    "generate:vocab-accent-audio": "ts-node scripts/generate-vocab-accent-audio.ts",
    "reconcile:listening-audio-duration": "ts-node scripts/reconcile-listening-audio-duration.ts",
    "start:speaking-worker": "node dist/src/worker/speaking-worker.main.js",
    "start:speaking-worker:dev": "ts-node src/worker/speaking-worker.main.ts",
    "db:backup:offsite": "ts-node scripts/db-backup-offsite.ts",
    "db:resync-sequences": "ts-node scripts/db-resync-sequences.ts",
    "reconstruct:canonical-toeic": "ts-node scripts/reconstruct-canonical-toeic.ts",
    "reconstruct:foundation-courses": "ts-node scripts/reconstruct-foundation-courses.ts",
    "relink:course-covers": "ts-node scripts/relink-course-covers.ts",
    "verify:canonical-baseline": "ts-node scripts/verify-canonical-baseline.ts",
    "materialize:exam1-listening": "ts-node scripts/materialize-exam1-listening-phase0.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/s3-request-presigner": "^3.1092.0",
    "@google/generative-ai": "^0.24.1",
    "@nestjs-modules/ioredis": "^2.2.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.29",
    "@payos/node": "^2.0.5",
    "@prisma/client": "^6.2.1",
    "@types/pdf-parse": "^1.1.5",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.10.0",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^11.0.2",
    "ioredis": "^5.11.1",
    "mammoth": "^1.12.1",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "music-metadata": "^11.15.0",
    "nest-winston": "^1.10.2",
    "nodemailer": "^10.0.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "streamifier": "^0.1.1",
    "web-push": "^3.6.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/streamifier": "^0.1.2",
    "@types/supertest": "^7.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "jest-mock-extended": "^4.0.1",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "roots": [
      "<rootDir>",
      "<rootDir>/../prisma",
      "<rootDir>/../test/safety"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/../test/safety/jest-global-setup.ts",
    "setupFiles": [
      "<rootDir>/../test/safety/jest-setup-isolation.ts"
    ]
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
