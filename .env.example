# Database Setup
DATABASE_URL="postgresql://postgres:password@localhost:5432/kltn_db?schema=public"

# Redis Setup
REDIS_HOST="localhost"
REDIS_PORT=6379

# Local speaking pipeline (do not use live provider credentials in tests)
SPEAKING_PIPELINE_MODE=bullmq
SPEAKING_AUDIO_UPLOAD_MODE=presigned
MOCK_AZURE_SPEECH=true

# Disposable local MinIO/S3-compatible storage for Speaking pipeline demos only.
# Do not use these values in production.
CURRENT_ENVIRONMENT=LOCAL_DEVELOPMENT_ONLY
LOCAL_S3_ENDPOINT="http://127.0.0.1:9000"
LOCAL_S3_BUCKET="breadtrans-speaking-local"
LOCAL_S3_ACCESS_KEY_ID="breadtrans_local_access"
LOCAL_S3_SECRET_ACCESS_KEY="replace-with-local-only-secret"
LOCAL_S3_FORCE_PATH_STYLE=true
LOCAL_S3_PUBLIC_URL="http://127.0.0.1:9000/breadtrans-speaking-local"

# JWT Token
JWT_SECRET="YOUR_SUPER_SECRET_JWT_KEY_HERE"

# AI Integration
# Lấy API Key từ https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GOOGLE_GEMINI_API_KEY_HERE"

# Cloudflare R2 Storage Setup (Upload Ảnh, Audio, PDF)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="breadtrans-files"
R2_PUBLIC_URL="https://pub-your_id.r2.dev"

# Private bucket for premium Listening media. Leave unset until a genuinely
# private bucket is provisioned; premium authoring fails closed without it.
R2_PRIVATE_BUCKET_NAME="breadtrans-premium-media"
R2_PRIVATE_ENDPOINT=""
R2_PRIVATE_ACCESS_KEY_ID=""
R2_PRIVATE_SECRET_ACCESS_KEY=""
R2_PRIVATE_FORCE_PATH_STYLE=false

# Azure AI Speech (Chấm điểm phát âm chuẩn âm vị - Gói Free F0)
AZURE_SPEECH_KEY="YOUR_AZURE_SPEECH_F0_KEY"
AZURE_SPEECH_REGION="southeastasia"

# OTP Secret (HMAC-SHA256)
OTP_SECRET="YOUR_OTP_SECRET_KEY_HERE"

# Web Push Notifications (Rotate via: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:admin@breadtrans.com"

# Automated Background Cronjobs
CRON_INTERNAL_ENABLED=false
# SMTP Email
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="no-reply@example.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="BreadTrans <no-reply@example.com>"
FRONTEND_URL="http://localhost:3000"

# PayOS merchant credentials (server-side only; keep values empty in templates)
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
PAYMENT_INTENT_TTL_MINUTES=15

# Google OAuth (Google Cloud OAuth 2.0 Web application)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Phase 3C payment bank config (fake examples only)
